{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Korean K1 vocabulary array",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "language",
      "lemma",
      "pos",
      "sense",
      "gloss_ja",
      "level",
      "tier",
      "rank",
      "tags",
      "allow_inflection",
      "introduced_from",
      "introduced_to",
      "target_exposures",
      "forms",
      "notes"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^ko_k1_[0-9]{4}$"
      },
      "language": {
        "const": "ko"
      },
      "lemma": {
        "type": "string",
        "minLength": 1
      },
      "pos": {
        "enum": [
          "noun",
          "verb",
          "adjective",
          "adverb",
          "pronoun",
          "determiner",
          "numeral",
          "counter",
          "conjunction",
          "interjection"
        ]
      },
      "sense": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "gloss_ja": {
        "type": "string",
        "minLength": 1
      },
      "level": {
        "const": "K1"
      },
      "tier": {
        "enum": [
          "core",
          "E1",
          "E2",
          "E3"
        ]
      },
      "rank": {
        "type": "integer",
        "minimum": 1,
        "maximum": 800
      },
      "tags": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        }
      },
      "allow_inflection": {
        "type": "boolean"
      },
      "introduced_from": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1,
        "maximum": 255
      },
      "introduced_to": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1,
        "maximum": 255
      },
      "target_exposures": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 6,
        "maximum": 300
      },
      "forms": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "notes": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "category": {
        "type": "string",
        "pattern": "^[a-z]+(?:_[a-z]+)*$"
      },
      "confidence": {
        "enum": [
          "high",
          "medium",
          "low"
        ]
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "tier": {
              "const": "core"
            }
          }
        },
        "then": {
          "properties": {
            "introduced_from": {
              "type": "null"
            },
            "introduced_to": {
              "type": "null"
            },
            "target_exposures": {
              "type": "null"
            }
          }
        },
        "else": {
          "properties": {
            "introduced_from": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "introduced_to": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "target_exposures": {
              "type": "integer",
              "minimum": 6,
              "maximum": 300
            }
          }
        }
      }
    ]
  }
}

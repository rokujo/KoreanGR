{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "text_number",
    "title_ko",
    "genre",
    "scene",
    "sentences",
    "translations_ja",
    "scene_fingerprint",
    "semantic_evidence"
  ],
  "properties": {
    "text_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "title_ko": {
      "type": "string",
      "minLength": 1
    },
    "genre": {
      "enum": [
        "daily_life",
        "school",
        "family",
        "friends",
        "friendship",
        "food",
        "shopping",
        "transport",
        "weather",
        "home",
        "small_problem",
        "short_dialogue",
        "simple_outing",
        "objects",
        "simple_hobby",
        "health",
        "outdoor",
        "travel",
        "work"
      ]
    },
    "scene": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "food",
          "kitchen",
          "school",
          "shopping",
          "transport",
          "travel",
          "home",
          "health",
          "body",
          "outdoor",
          "nature",
          "work",
          "communication",
          "friendship",
          "family",
          "object_problem",
          "lost_and_found"
        ]
      }
    },
    "sentences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "translations_ja": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scene_fingerprint": {
      "type": "object",
      "required": [
        "goal",
        "setting",
        "participants",
        "problem_type",
        "resolution_type",
        "main_actions"
      ],
      "properties": {
        "main_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "semantic_evidence": {
      "type": "object",
      "required": [
        "coherent_goal",
        "plausible_actions",
        "no_review_only_actions",
        "natural_arguments",
        "clear_references",
        "necessary_genitives",
        "meaningful_adverbs",
        "simple_natural_construction"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "verdict",
          "reason"
        ],
        "properties": {
          "verdict": {
            "enum": [
              "YES",
              "NO",
              "REVIEW"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "generated_intents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "vocab_id",
          "lemma",
          "pos",
          "sense"
        ]
      }
    },
    "review_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

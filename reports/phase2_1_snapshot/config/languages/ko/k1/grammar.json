[
  {
    "id": "ko_k1_g01",
    "form": "이다: 이에요/예요",
    "meaning_ja": "〜です",
    "category": "copula",
    "example": "여기는 우리 집이에요.",
    "notes": "名詞述語。받침あり이에요、なし예요。過去였어요/이었어요はg03と組み合わせる。否定はCore 아니다でN이/가 아니에요。"
  },
  {
